{
  "name": "genealogia-compendium",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "genealogia.rsorage.com — compêndio das famílias Sorage (Suraci) e Cardillo. Site estático gerado com Astro a partir do acervo privado.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "exportar": "python3 scripts/exportar-registros.py && python3 scripts/exportar-pessoas-documentos.py",
    "exportar:verificar": "python3 scripts/exportar-registros.py --verificar && python3 scripts/exportar-pessoas-documentos.py --verificar",
    "test:py": "python3 -m unittest discover -s tests -p 'test_*.py'"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.4",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.7",
    "d3": "^7.9.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/d3": "^7.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
