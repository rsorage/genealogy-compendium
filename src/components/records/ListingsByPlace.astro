---
/**
 * Links to every static catalogue page, grouped by comune.
 * This is what Google reads (the search island only exists in the browser).
 */
import { byPlace, type Slice } from '../../lib/records';

interface Props {
  slices: Slice[];
  /** When true, shows the section heading; on the catalogue pages it is the h1 itself. */
  withTitle?: boolean;
}
const { slices, withTitle = true } = Astro.props;
const groups = byPlace(slices);
---

<section class="space-y-6" aria-labelledby="listagens-titulo">
  {
    withTitle && (
      <div class="border-b border-[#E7E2D8] pb-4 flex flex-col sm:flex-row sm:items-end justify-between gap-2">
        <div>
          <div class="text-xs uppercase tracking-widest font-sans font-semibold text-[#8C3A27]">Consulta por fonte</div>
          <h2 id="listagens-titulo" class="font-display text-3xl font-medium text-[#1C1917]">
            Transcrições por localidade e ano
          </h2>
          <p class="font-editorial text-sm text-[#57534E] mt-1 max-w-2xl">
            Cada recorte é uma página legível sem JavaScript, com os nomes agrupados por ato e as referências para
            conferir as imagens originais.
          </p>
        </div>
        <a href="/registros-vistos/catalogo/" class="text-xs font-semibold text-[#8C3A27] hover:underline whitespace-nowrap">
          Índice completo do catálogo →
        </a>
      </div>
    )
  }
  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-x-10 gap-y-8">
    {
      groups.map(({ comune, slices }) => (
        <section class="min-w-0">
          <h3 class="font-display text-xl font-semibold text-[#1C1917] mb-2">{comune}</h3>
          <ul class="border-t border-[#E7E2D8]">
            {slices.map((s) => (
              <li class="py-2 border-b border-[#EFEAE0] text-sm font-sans flex items-baseline justify-between gap-3">
                <a href={s.path} class="text-[#1C1917] hover:text-[#8C3A27] hover:underline">
                  {s.series} <span class="font-mono text-[#8C3A27] tabular-nums">· {s.year}</span>
                </a>
                <small class="text-[#78716C] whitespace-nowrap tabular-nums">
                  {s.rows.length} {s.rows.length === 1 ? 'ocorrência' : 'ocorrências'}
                </small>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</section>
