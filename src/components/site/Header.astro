---
import { SECTIONS, activeSection } from '../../lib/navigation';
import HeaderActions from './HeaderActions';

const active = activeSection(Astro.url.pathname);
---

<header class="sticky top-0 z-40 bg-[#FBF9F5]/95 backdrop-blur-md border-b border-[#E7E2D8] transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Zone 1 (wordmark) — Zone 2 (navigation) — Zone 3 (search + primary action) -->
    <div class="flex items-center justify-between gap-4 lg:gap-6 h-18">
      <a href="/" class="text-left group shrink-0 focus:outline-none" aria-label="Sorage & Cardillo — página inicial">
        <span
          class="font-display text-xl sm:text-2xl font-medium tracking-tight text-[#1C1917] group-hover:text-[#8C3A27] transition-colors whitespace-nowrap"
        >
          SORAGE &amp; CARDILLO
        </span>
      </a>

      <nav class="hidden lg:flex items-center gap-5 xl:gap-6 text-sm font-medium text-[#57534E]" aria-label="Seções do site">
        {
          SECTIONS.map((s) => (
            <a
              href={s.path}
              aria-current={active === s.id ? 'page' : undefined}
              class:list={[
                'hover:text-[#1C1917] transition-colors whitespace-nowrap shrink-0 pb-1',
                active === s.id
                  ? 'text-[#1C1917] border-b-2 border-[#8C3A27] font-semibold'
                  : 'hover:border-b-2 hover:border-[#D6CEBE]',
              ]}
            >
              {s.shortLabel}
            </a>
          ))
        }
      </nav>

      <HeaderActions client:load />
    </div>

    <!-- Mobile navigation -->
    <nav
      class="lg:hidden flex items-center justify-between overflow-x-auto py-2.5 border-t border-[#E7E2D8] text-xs font-medium text-[#57534E] gap-3 scrollbar-none"
      aria-label="Seções do site"
    >
      {
        SECTIONS.map((s) => (
          <a
            href={s.path}
            aria-current={active === s.id ? 'page' : undefined}
            class:list={[
              'whitespace-nowrap px-2 py-1 rounded',
              active === s.id ? 'text-[#8C3A27] font-semibold bg-[#F3EFE6]' : '',
            ]}
          >
            {s.shortLabel}
          </a>
        ))
      }
    </nav>
  </div>
</header>
