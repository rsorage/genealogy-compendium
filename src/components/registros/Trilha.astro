---
/** Trilha de navegação (breadcrumbs) com o JSON-LD correspondente. */
interface Item {
  nome: string;
  caminho: string;
}
interface Props {
  itens: Item[];
}
const { itens } = Astro.props;
---

<nav class="text-xs font-sans text-[#78716C] flex flex-wrap items-center gap-2" aria-label="Caminho">
  {
    itens.map((item, i) => (
      <>
        {i > 0 && <span aria-hidden="true">/</span>}
        {i < itens.length - 1 ? (
          <a href={item.caminho} class="text-[#8C3A27] hover:underline">
            {item.nome}
          </a>
        ) : (
          <span aria-current="page" class="text-[#57534E]">
            {item.nome}
          </span>
        )}
      </>
    ))
  }
</nav>
