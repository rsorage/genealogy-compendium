---
import { caminhoPessoa, periodoVida, rotuloOcupacao, type Pessoa } from '../../lib/pessoas';

interface Props {
  pessoa: Pessoa;
  /** texto pequeno à direita (ex.: «pai», «cônjuge»), opcional */
  rotulo?: string;
  compacto?: boolean;
}
const { pessoa, rotulo, compacto = false } = Astro.props;
const vida = periodoVida(pessoa);
const lugar = pessoa.nascimento?.lugar ?? pessoa.morte?.lugar ?? '';
---

<a
  href={caminhoPessoa(pessoa.id)}
  class:list={[
    'group block bg-white border border-[#E7E2D8] hover:border-[#8C3A27] rounded-lg transition-colors',
    compacto ? 'px-3 py-2' : 'p-4',
  ]}
>
  <div class="flex items-baseline justify-between gap-3">
    <span class:list={['font-display font-semibold text-[#1C1917] group-hover:text-[#8C3A27] leading-snug', compacto ? 'text-base' : 'text-lg']}>
      {pessoa.nome_exibicao}
    </span>
    {rotulo && <span class="text-[10px] uppercase tracking-wider font-sans text-[#78716C] shrink-0">{rotulo}</span>}
  </div>
  {
    (vida || lugar) && (
      <div class="text-xs font-sans text-[#57534E] mt-0.5">
        {vida && <span class="font-mono tabular-nums text-[#8C3A27]">{vida}</span>}
        {vida && lugar && <span aria-hidden="true"> · </span>}
        {lugar && <span>{lugar}</span>}
      </div>
    )
  }
  {!compacto && pessoa.ocupacao && <div class="text-xs font-sans text-[#78716C] mt-0.5">{rotuloOcupacao(pessoa.ocupacao)}</div>}
</a>
