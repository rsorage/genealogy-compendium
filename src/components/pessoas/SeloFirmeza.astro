---
import { CLASSE_FIRMEZA, EXPLICACAO_FIRMEZA, ROTULO_FIRMEZA, type Firmeza } from '../../lib/pessoas';

interface Props {
  firmeza: Firmeza;
  prefixo?: string;
}
const { firmeza, prefixo = '' } = Astro.props;
---

<span
  class:list={['inline-flex items-center gap-1 text-[11px] font-sans font-medium px-2 py-0.5 rounded border whitespace-nowrap', CLASSE_FIRMEZA[firmeza]]}
  title={EXPLICACAO_FIRMEZA[firmeza]}
>
  <span
    aria-hidden="true"
    class="inline-block w-3 border-t-2 border-current"
    style={`border-top-style: ${firmeza === 'certa' ? 'solid' : firmeza === 'duvidosa' ? 'dotted' : 'dashed'}`}
  ></span>
  {prefixo}{ROTULO_FIRMEZA[firmeza]}
</span>
