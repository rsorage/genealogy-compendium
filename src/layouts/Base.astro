---
import '../styles/global.css';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Canonical path (with trailing slash). Default: the page URL. */
  path?: string;
  /** Sharing image, relative to the site root. */
  ogImage?: string;
  /** Marks the page as not to be indexed (e.g. drafts). */
  noindex?: boolean;
  /** Additional JSON-LD (already serialised); one or several blocks. */
  jsonLd?: string | string[];
  /** Maximum content width. */
  width?: 'normal' | 'wide';
}

const SITE_NAME = 'Sorage & Cardillo';
const {
  title,
  description,
  path = Astro.url.pathname,
  ogImage = '/og/portal.jpg',
  noindex = false,
  jsonLd,
  width = 'normal',
} = Astro.props;

const site = Astro.site ?? new URL('https://genealogia.rsorage.com');
const canonical = new URL(path, site).toString();
const og = new URL(ogImage, site).toString();
const fullTitle = path === '/' ? `${SITE_NAME} · Compêndio genealógico` : `${title} | ${SITE_NAME}`;
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Ramon Sorage" />
    <meta name="theme-color" content="#fbf9f5" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && (Array.isArray(jsonLd) ? jsonLd : [jsonLd]).map((block) => <script type="application/ld+json" set:html={block} />)}
  </head>
  <body class="bg-[#FBF9F5] text-[#1C1917] antialiased selection:bg-[#E2D9CC] selection:text-[#1C1917]">
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-[#1C1917] focus:text-[#FBF9F5] focus:px-3 focus:py-2 focus:rounded-md focus:text-sm"
      >Ir para o conteúdo</a
    >
    <div class="min-h-screen flex flex-col">
      <Header />
      <main
        id="conteudo"
        class:list={[
          'flex-1 w-full mx-auto px-4 sm:px-6 lg:px-8',
          width === 'wide' ? 'max-w-[90rem]' : 'max-w-7xl',
        ]}
      >
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
