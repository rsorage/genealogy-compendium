---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/site/Breadcrumbs.astro';
import ConfidenceBadge from '../../components/persons/ConfidenceBadge.astro';
import PersonCard from '../../components/persons/PersonCard.astro';
import { loadArchive } from '../../lib/persons-build';
import { breadcrumbsJsonLd } from '../../lib/records';
import { placeLabel } from '../../lib/places';
import {
  LINE_LABEL,
  RELATION_LABEL,
  RELATION_ORDER,
  documentTypeLabel,
  documentPath,
  personPath,
  readableArchiveDate,
  lifeSpan,
  occupationLabel,
  rolesLabel,
  type Person,
} from '../../lib/persons';

export async function getStaticPaths() {
  const { persons } = await loadArchive();
  return persons.filter((p) => !p.no_dossier).map((p) => ({ params: { id: p.id }, props: { person: p } }));
}

interface Props {
  person: Person;
}
const { person } = Astro.props;
const { personById, documentById } = await loadArchive();

const life = lifeSpan(person);
const groups = RELATION_ORDER.map((type) => ({
  type,
  items: person.relations.filter((r) => r.type === type),
}));
const hasFamily = person.relations.length > 0;
type Event = NonNullable<Person['birth']>;
const events: [string, Event][] = [];
if (person.birth) events.push(['Nascimento', person.birth]);
if (person.death) events.push(['Morte', person.death]);
const appearances = person.appearances
  .map((a) => ({ ...a, doc: documentById.get(a.document)! }))
  .sort((a, b) => a.doc.date.localeCompare(b.doc.date));
const documentedInBrazil = appearances.some((a) => a.doc.country === 'BR');
const trail = [
  { name: 'Pessoas', path: '/pessoas/' },
  { name: LINE_LABEL[person.line], path: `/pessoas/#${person.line}` },
  { name: person.display_name, path: personPath(person.id) },
];
const description = [
  person.display_name,
  life ? `(${life})` : '',
  person.birth?.place ? `, ${placeLabel(person.birth.place)}` : '',
  ' — ',
  person.public_summary || `o que ${appearances.length} ${appearances.length === 1 ? 'documento diz' : 'documentos dizem'} sobre esta pessoa, com a firmeza de cada fato e de cada parentesco.`,
].join('');

const iso = (d?: string) => (d && /^\d{4}(-\d{2}(-\d{2})?)?$/.test(d) ? d : undefined);
const personRef = (id: string) => ({ '@type': 'Person', name: personById.get(id)?.display_name, url: `https://genealogia.rsorage.com${personPath(id)}` });
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.display_name,
  alternateName: person.aliases,
  url: `https://genealogia.rsorage.com${personPath(person.id)}`,
  ...(iso(person.birth?.date) ? { birthDate: iso(person.birth?.date) } : {}),
  ...(iso(person.death?.date) ? { deathDate: iso(person.death?.date) } : {}),
  ...(person.birth?.place ? { birthPlace: placeLabel(person.birth.place) } : {}),
  ...(person.death?.place ? { deathPlace: placeLabel(person.death.place) } : {}),
  ...(person.occupation ? { jobTitle: occupationLabel(person.occupation) } : {}),
  parent: person.relations.filter((r) => r.type === 'father' || r.type === 'mother').map((r) => personRef(r.person)),
  spouse: person.relations.filter((r) => r.type === 'spouse').map((r) => personRef(r.person)),
  children: person.relations.filter((r) => r.type === 'child').map((r) => personRef(r.person)),
}).replace(/</g, '\\u003c');
---

<Base title={person.display_name} description={description} path={personPath(person.id)} jsonLd={[jsonLd, breadcrumbsJsonLd(trail)]}>
  <div class="space-y-10 py-8">
    <Breadcrumbs items={trail} />

    <!-- Header -->
    <section class="border-b border-[#E7E2D8] pb-8 grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-8 space-y-3">
        <div class="text-xs uppercase tracking-widest font-sans font-semibold text-[#8C3A27]">{LINE_LABEL[person.line]}</div>
        <h1 class="font-display text-4xl sm:text-5xl font-medium tracking-tight text-[#1C1917] leading-[1.1]">{person.display_name}</h1>
        {
          person.aliases.length > 0 && (
            <p class="font-editorial text-base text-[#57534E]">
              Também escrito{' '}
              {person.aliases.map((n, i) => (
                <>
                  <span class="text-[#1C1917]">{n}</span>
                  {i < person.aliases.length - 1 ? ', ' : ''}
                </>
              ))}
            </p>
          )
        }
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm font-sans text-[#57534E]">
          {life && <span class="font-mono tabular-nums text-[#8C3A27] font-semibold">{life}</span>}
          {person.occupation && <span>{occupationLabel(person.occupation)}</span>}
          {person.sex !== '?' && <span class="text-[#A8A29E]">{person.sex === 'F' ? 'mulher' : 'homem'}</span>}
        </div>
        {person.public_summary && <p class="font-editorial text-lg text-[#292524] leading-relaxed pt-2 max-w-3xl">{person.public_summary}</p>}
        {
          person.needs_research && (
            <p class="text-xs font-sans bg-[#FBF4E6] border border-[#EBD9B4] text-[#8A5A14] rounded-md px-3 py-2 inline-block">
              <strong>Carece pesquisa.</strong> Esta pessoa está no acervo só por fonte secundária (a Árvore Familiar do FamilySearch); nada foi conferido em documento.
            </p>
          )
        }
      </div>
      <aside class="lg:col-span-4 bg-[#F5F1E8] border border-[#E5DFD3] p-5 rounded-lg space-y-3 text-xs font-sans">
        <div class="uppercase tracking-widest font-semibold text-[#8C3A27]">Ligações</div>
        <ul class="space-y-1.5">
          <li>
            <a href={`/arvore/?pessoa=${person.id}`} class="text-[#1C1917] font-semibold hover:text-[#8C3A27] hover:underline">Ver na árvore →</a>
          </li>
          {
            person.familysearch && (
              <li>
                <a href={`https://www.familysearch.org/tree/person/details/${person.familysearch}`} target="_blank" rel="noopener noreferrer" class="text-[#57534E] hover:text-[#8C3A27] hover:underline">
                  Árvore Familiar do FamilySearch ({person.familysearch}) ↗
                </a>
              </li>
            )
          }
          <li class="text-[#78716C]">{appearances.length} {appearances.length === 1 ? 'documento a nomeia' : 'documentos a nomeiam'} · {person.relations.length} {person.relations.length === 1 ? 'parentesco' : 'parentescos'} documentados</li>
        </ul>
        <p class="pt-2 border-t border-[#E5DFD3] text-[#78716C] leading-relaxed">
          Cada fato traz a sua firmeza (certa, declarada, provável, duvidosa) e a base que o sustenta. Conclusão sem evidência não entra.
        </p>
      </aside>
    </section>

    <!-- Facts -->
    {
      (person.birth || person.death) && (
        <section class="space-y-4" aria-labelledby="fatos">
          <h2 id="fatos" class="font-display text-2xl sm:text-3xl font-medium text-[#1C1917]">O que se sabe, e com que firmeza</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {events.map(([label, ev]) => (
                <article class="bg-white border border-[#E7E2D8] rounded-xl p-5 space-y-3">
                  <div class="flex items-center justify-between gap-3">
                    <h3 class="font-display text-xl font-semibold text-[#1C1917]">{label}</h3>
                    <ConfidenceBadge confidence={ev.confidence} />
                  </div>
                  <p class="font-editorial text-lg text-[#292524]">
                    {ev.date ? readableArchiveDate(ev.date) : <span class="text-[#78716C]">data não conhecida</span>}
                    {ev.place && <span class="text-[#57534E]"> · {placeLabel(ev.place)}</span>}
                  </p>
                  <div class="bg-[#FAF7F2] border border-[#E7E0D2] rounded-lg p-3.5 space-y-2">
                    <div class="text-[10px] uppercase tracking-widest font-sans font-semibold text-[#78716C]">Base</div>
                    <p class="font-sans text-xs text-[#44403C] leading-relaxed">{ev.basis}</p>
                    {ev.documents.length > 0 && (
                      <p class="flex flex-wrap gap-x-3 gap-y-1 text-xs font-sans pt-1">
                        {ev.documents.map((id) => (
                          <a href={documentPath(id)} class="text-[#8C3A27] font-semibold hover:underline">
                            {documentById.get(id)?.title ?? id}
                          </a>
                        ))}
                      </p>
                    )}
                  </div>
                </article>
              ))}
          </div>
        </section>
      )
    }

    <!-- Family -->
    <section class="space-y-4" aria-labelledby="familia">
      <h2 id="familia" class="font-display text-2xl sm:text-3xl font-medium text-[#1C1917]">Família</h2>
      {
        hasFamily ? (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {groups
              .filter((g) => g.items.length > 0)
              .map((g) => (
                <div class="space-y-2">
                  <h3 class="text-xs uppercase tracking-widest font-sans font-semibold text-[#78716C]">
                    {RELATION_LABEL[g.type]}
                    {g.items.length > 1 && g.type !== 'father' && g.type !== 'mother' ? ` (${g.items.length})` : ''}
                  </h3>
                  <ul class="space-y-2">
                    {g.items.map((r) => {
                      const other = personById.get(r.person)!;
                      return (
                        <li class="space-y-1">
                          <PersonCard person={other} compact />
                          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] font-sans text-[#78716C] px-1">
                            <ConfidenceBadge confidence={r.confidence} />
                            <span>segundo</span>
                            {r.documents.map((id) => (
                              <a href={documentPath(id)} class="text-[#8C3A27] hover:underline">
                                {documentById.get(id)?.title ?? id}
                              </a>
                            ))}
                            {r.documents.length === 0 && r.reference && <span class="italic">{r.reference}</span>}
                          </div>
                          {r.rationale && <p class="text-xs font-sans text-[#57534E] leading-relaxed px-1">{r.rationale}</p>}
                        </li>
                      );
                    })}
                  </ul>
                </div>
              ))}
          </div>
        ) : (
          <p class="font-editorial text-base text-[#57534E]">Nenhum parentesco documentado entre as pessoas publicadas.</p>
        )
      }
      {
        documentedInBrazil && (
          <p class="text-xs font-sans text-[#78716C] border-t border-[#EFEAE0] pt-3">
            Parentes nascidos no Brasil ainda não estão publicados: nesta fase o site cobre as pessoas nascidas na Itália.
          </p>
        )
      }
    </section>

    <!-- In the documents -->
    <section class="space-y-4" aria-labelledby="documentos">
      <div>
        <h2 id="documentos" class="font-display text-2xl sm:text-3xl font-medium text-[#1C1917]">Nos documentos</h2>
        <p class="font-editorial text-sm text-[#57534E] mt-1">
          Como cada ato a escreveu — nome, papel, idade e ofício são os que <em>aquele</em> escrivão anotou, não conclusões nossas.
        </p>
      </div>
      {
        appearances.length > 0 ? (
          <ol class="divide-y divide-[#EFEAE0] border-y border-[#E7E2D8]">
            {appearances.map((a) => (
              <li class="py-4 grid grid-cols-1 sm:grid-cols-[120px_minmax(0,1fr)] gap-x-6 gap-y-1">
                <div class="font-mono text-sm tabular-nums text-[#8C3A27]">{readableArchiveDate(a.doc.date)}</div>
                <div class="space-y-1">
                  <a href={documentPath(a.doc.id)} class="font-display text-lg font-semibold text-[#1C1917] hover:text-[#8C3A27] leading-snug">
                    {a.doc.title}
                  </a>
                  <div class="text-xs font-sans text-[#57534E]">
                    {documentTypeLabel(a.doc)} · {a.doc.place}
                  </div>
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-sans">
                    <span class="font-medium px-2 py-0.5 rounded bg-[#FAF7F0] border border-[#E7E0D2] text-[#57534E]">{rolesLabel(a.roles)}</span>
                    <span class="font-editorial italic text-[#292524]">«{a.name_as_written}»</span>
                    {a.age !== undefined && <span class="text-[#78716C]">{a.age} anos declarados</span>}
                    {a.occupation && <span class="text-[#78716C]">{a.occupation}</span>}
                    {a.literate !== undefined && <span class="text-[#78716C]">{a.literate ? 'assina' : 'não sabe escrever'}</span>}
                  </div>
                </div>
              </li>
            ))}
          </ol>
        ) : (
          <p class="font-editorial text-base text-[#57534E]">Nenhum documento publicado a nomeia ainda.</p>
        )
      }
    </section>
  </div>
</Base>
