---
import Base from '../../layouts/Base.astro';
import DocumentList, { type DocumentSummary } from '../../components/documents/DocumentList';
import { loadArchive } from '../../lib/persons-build';
import { LINE_LABEL, documentTypeLabel, documentPath, readableArchiveDate } from '../../lib/persons';

const { documents, personById } = await loadArchive();
const summaries: DocumentSummary[] = documents.map((d) => ({
  id: d.id,
  title: d.title,
  typeLabel: documentTypeLabel(d),
  year: d.year,
  readableDate: readableArchiveDate(d.date),
  place: d.place,
  lines: d.lines,
  linesLabel: d.lines.map((l) => LINE_LABEL[l].split(' (')[0]).join(' · '),
  persons: d.persons.map((p) => personById.get(p.person)?.display_name ?? p.person),
  hasLink: !!d.url,
  hasTranscription: !!d.transcription,
  path: documentPath(d.id),
}));
const withLink = documents.filter((d) => d.url).length;
const withTranscription = documents.filter((d) => d.transcription).length;
const places = new Set(documents.map((d) => d.place)).size;
const fmt = (n: number) => n.toLocaleString('pt-BR');
---

<Base
  title="Documentos"
  description={`${fmt(documents.length)} atos civis e paroquiais, catasti e certidões lidos na pesquisa das famílias Suraci e Cardillo, com quem aparece em cada um, a transcrição e o link para a imagem no portal de origem.`}
>
  <div class="space-y-10 py-8">
    <section class="border-b border-[#E7E2D8] pb-8">
      <div class="text-xs uppercase tracking-widest font-sans font-semibold text-[#8C3A27] mb-2">Fontes primárias · uma página por documento</div>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-8 space-y-4">
          <h1 class="font-display text-4xl sm:text-5xl font-medium tracking-tight text-[#1C1917] leading-[1.1]">Documentos</h1>
          <p class="font-editorial text-lg sm:text-xl text-[#44403C] leading-relaxed">
            Os atos de nascimento, batismo, casamento e óbito, os catasti e as certidões em que a pesquisa se apoia. Cada
            página diz quem está no ato — com o nome, a idade e o ofício que o escrivão escreveu —, traz a transcrição
            feita sobre a imagem e aponta para o original no portal de origem.
          </p>
          <p class="font-editorial text-base text-[#57534E] leading-relaxed">
            Nenhuma imagem é hospedada aqui. Documentos até 1925 têm a transcrição integral; óbitos até 1955 só os
            trechos genealógicos.
          </p>
        </div>
        <aside class="lg:col-span-4 bg-[#F5F1E8] border border-[#E5DFD3] p-5 rounded-lg space-y-2 text-xs font-sans">
          <div class="uppercase tracking-widest font-semibold text-[#8C3A27]">Nesta exportação</div>
          <dl class="grid grid-cols-[1fr_auto] gap-x-4 gap-y-1.5 text-[#57534E]">
            <dt>Documentos</dt>
            <dd class="font-mono tabular-nums text-[#1C1917] font-semibold text-right">{fmt(documents.length)}</dd>
            <dt>Com imagem em portal público</dt>
            <dd class="font-mono tabular-nums text-[#1C1917] font-semibold text-right">{fmt(withLink)}</dd>
            <dt>Com transcrição</dt>
            <dd class="font-mono tabular-nums text-[#1C1917] font-semibold text-right">{fmt(withTranscription)}</dd>
            <dt>Lugares</dt>
            <dd class="font-mono tabular-nums text-[#1C1917] font-semibold text-right">{places}</dd>
          </dl>
        </aside>
      </div>
    </section>

    <DocumentList client:load documents={summaries} lineLabels={LINE_LABEL} />
  </div>
</Base>
