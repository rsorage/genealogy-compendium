---
/**
 * Uma página por recorte (localidade · série · ano), legível sem JavaScript.
 * Os endereços reproduzem os do site anterior: /registros-vistos/catalogo/<comune>/<serie>/<ano>/
 */
import Base from '../../../layouts/Base.astro';
import Trilha from '../../../components/registros/Trilha.astro';
import { carregarRegistros, parametroRecorte } from '../../../lib/registros-build';
import {
  dataLegivel,
  grauLeitura,
  idSecaoAto,
  jsonLdTrilha,
  nomeCompleto,
  nomeConjuge,
  ordenarAtos,
  referencia,
  ressalvaLeitura,
  rotuloAto,
  rotuloPapel,
  type Recorte,
} from '../../../lib/registros';

export async function getStaticPaths() {
  const { recortes } = await carregarRegistros();
  return recortes.map((r) => ({ params: { recorte: parametroRecorte(r) }, props: { recorte: r } }));
}

interface Props {
  recorte: Recorte;
}
const { recorte } = Astro.props;
const { comune, serie, ano, linhas } = recorte;
const atos = ordenarAtos(linhas);
const n = linhas.length;
const titulo = `${comune} — ${serie}, ${ano}: transcrições parciais`;
const descricao = `Nomes e participantes transcritos parcialmente em ${serie} de ${comune}, ${ano}. Referências, graus de leitura e links para conferir os originais.`;
const trilha = [
  { nome: 'Registros vistos', caminho: '/registros-vistos/' },
  { nome: 'Listagens', caminho: '/registros-vistos/catalogo/' },
  { nome: `${comune} · ${ano}`, caminho: recorte.caminho },
];

const CLASSE_LEITURA: Record<string, string> = {
  certa: 'text-[#2A6F54] bg-[#EEF5F0] border-[#CFE2D6]',
  provável: 'text-[#8A5A14] bg-[#FBF4E6] border-[#EBD9B4]',
  duvidosa: 'text-[#57534E] bg-[#F3EFE6] border-[#D6CEBE]',
};
---

<Base titulo={titulo} descricao={descricao} caminho={recorte.caminho} jsonLd={jsonLdTrilha(trilha)}>
  <div class="space-y-8 py-8">
    <Trilha itens={trilha} />

    <section class="border-b border-[#E7E2D8] pb-8 space-y-4 max-w-3xl">
      <div class="text-xs uppercase tracking-widest font-sans font-semibold text-[#8C3A27]">Registros vistos · transcrições parciais</div>
      <h1 class="font-display text-4xl sm:text-5xl font-medium tracking-tight text-[#1C1917] leading-[1.1]">
        {comune}
        <span class="block text-[0.55em] leading-snug tracking-normal text-[#8C3A27] mt-3">{serie} · {ano}</span>
      </h1>
      <p class="font-editorial text-lg text-[#44403C] leading-relaxed">
        {n} {n === 1 ? 'ocorrência transcrita' : 'ocorrências transcritas'} deste recorte, com os papéis de cada participante e
        as referências dos documentos.
      </p>
      <aside class="bg-[#FAF7F0] border border-[#E5DFD3] rounded-lg p-4 text-sm font-sans text-[#44403C]">
        <strong class="text-[#1C1917]">Uma pista para continuar sua pesquisa.</strong> Esta transcrição é parcial. Não
        encontrar um nome aqui não significa que esteja ausente dos documentos. Os graus de leitura não confirmam identidade
        ou parentesco. <a href="/registros-vistos/#sobre" class="text-[#8C3A27] underline decoration-[#E8D9CE] hover:decoration-[#8C3A27]">Entenda os limites da lista →</a>
      </aside>
    </section>

    {
      atos.length > 1 && (
        <details class="text-sm font-sans">
          <summary class="text-[#8C3A27] cursor-pointer">Ir para uma referência</summary>
          <ul class="mt-3 columns-2 sm:columns-3 gap-8 pl-5 list-disc text-[#44403C]">
            {atos.map(([chave, grupo]) => (
              <li class="break-inside-avoid py-0.5">
                <a href={`#${idSecaoAto(chave)}`} class="hover:text-[#8C3A27] hover:underline">
                  {rotuloAto(grupo[0])}
                </a>
              </li>
            ))}
          </ul>
        </details>
      )
    }

    {
      atos.map(([chave, grupo]) => (
        <section class="scroll-mt-24" id={idSecaoAto(chave)}>
          <h2 class="font-display text-2xl sm:text-3xl font-medium text-[#1C1917] border-b border-[#E7E2D8] pb-3">
            {rotuloAto(grupo[0])}
          </h2>
          <p class="text-xs font-sans text-[#78716C] mt-2">
            Participantes transcritos; a lista pode não incluir todos os nomes do documento.
          </p>
          {grupo.map((o) => {
            const grau = grauLeitura(o.leitura);
            const campos = [
              ['Papel no ato', o.papel],
              ['Pai', o.pai],
              ['Mãe', o.mae],
              ['Cônjuge', nomeConjuge(o)],
              ['Data indicada', dataLegivel(o.data_evento)],
              ['Referência', referencia(o)],
              ['Ressalva de leitura', ressalvaLeitura(o.leitura)],
              ['Conferência', o.conferencia],
              ['Portal de origem', o.portal],
            ].filter(([, v]) => v);
            return (
              <article id={o.id} class="catalogo-alvo py-6 border-b border-[#EFEAE0] scroll-mt-24">
                <h3 class="font-display text-2xl font-semibold text-[#1C1917] leading-snug">{nomeCompleto(o)}</h3>
                <p class="flex flex-wrap items-center gap-2 text-sm font-sans text-[#57534E] mt-1.5 mb-4">
                  <span>{rotuloPapel(o)}</span>
                  <span class:list={['text-[11px] font-medium px-2 py-0.5 rounded border', CLASSE_LEITURA[grau]]}>
                    Leitura {grau}
                  </span>
                </p>
                <dl class="grid grid-cols-1 sm:grid-cols-[140px_minmax(0,1fr)] gap-x-6 gap-y-1.5 text-sm font-sans">
                  {campos.map(([k, v]) => (
                    <>
                      <dt class="text-[#78716C]">{k}</dt>
                      <dd class="text-[#1C1917] mb-1 sm:mb-0">{v}</dd>
                    </>
                  ))}
                </dl>
                {o.nota && <p class="font-editorial text-base text-[#292524] leading-relaxed mt-4">{o.nota}</p>}
                <p class="flex flex-wrap gap-x-5 gap-y-1 text-sm font-sans mt-4">
                  <a href={o.url} target="_blank" rel="noopener noreferrer" class="text-[#8C3A27] font-semibold hover:underline">
                    Conferir no portal de origem&nbsp;↗
                  </a>
                  {o.url_alternativa && (
                    <a href={o.url_alternativa} target="_blank" rel="noopener noreferrer" class="text-[#57534E] hover:text-[#1C1917] hover:underline">
                      Ver também no {o.portal_alternativo}&nbsp;↗
                    </a>
                  )}
                  <a href={`${recorte.caminho}#${o.id}`} class="text-[#57534E] hover:text-[#1C1917] hover:underline">
                    Link desta ocorrência
                  </a>
                </p>
              </article>
            );
          })}
        </section>
      ))
    }

    <aside class="font-sans text-sm text-[#44403C] leading-relaxed max-w-3xl border-t border-[#E7E2D8] pt-6 space-y-3">
      <p>
        As imagens permanecem nos portais de origem, que podem exigir cadastro ou restringir o acesso. Este catálogo é
        independente desses serviços.
      </p>
      <p>
        Os nomes são preservados como transcritos, inclusive seus sinais de dúvida. As transcrições podem conter erros;
        confira a imagem original antes de usar uma informação. A presença de pessoas no mesmo documento não estabelece
        parentesco entre elas.
      </p>
      <p>
        Viu um erro? Escreva para <a href="mailto:rsorage@gmail.com" class="text-[#8C3A27] underline decoration-[#E8D9CE]">rsorage@gmail.com</a>,
        indicando o link da ocorrência e a referência.
      </p>
      <p>
        <a href="/registros-vistos/catalogo/" class="text-[#8C3A27] font-semibold hover:underline">Explorar outras localidades e anos →</a>
      </p>
    </aside>
  </div>
</Base>
