---
import Base from '../../../layouts/Base.astro';
import ListingsByPlace from '../../../components/records/ListingsByPlace.astro';
import Breadcrumbs from '../../../components/site/Breadcrumbs.astro';
import { loadRecords } from '../../../lib/records-build';
import { breadcrumbsJsonLd } from '../../../lib/records';

const { slices, meta } = await loadRecords();
const trail = [
  { name: 'Registros vistos', path: '/registros-vistos/' },
  { name: 'Listagens', path: '/registros-vistos/catalogo/' },
];
---

<Base
  title="Transcrições parciais por localidade e ano"
  description="Explore nomes transcritos de registros históricos por localidade, série e ano, com graus de leitura e links para os documentos de origem."
  jsonLd={breadcrumbsJsonLd(trail)}
>
  <div class="space-y-10 py-8">
    <Breadcrumbs items={trail} />
    <section class="border-b border-[#E7E2D8] pb-8 space-y-4 max-w-3xl">
      <div class="text-xs uppercase tracking-widest font-sans font-semibold text-[#8C3A27]">Registros vistos · consulta por fonte</div>
      <h1 class="font-display text-4xl sm:text-5xl font-medium tracking-tight text-[#1C1917] leading-[1.1]">
        Transcrições por <em class="text-[#8C3A27] not-italic">localidade e ano</em>
      </h1>
      <p class="font-editorial text-lg text-[#44403C] leading-relaxed">
        Nomes que anotamos nos livros e documentos consultados, com referências para conferir as imagens originais.
        {slices.length} recortes, {meta.totals.names.toLocaleString('pt-BR')} ocorrências.
      </p>
      <aside class="bg-[#FAF7F0] border border-[#E5DFD3] rounded-lg p-4 text-sm font-sans text-[#44403C]">
        <strong class="text-[#1C1917]">Transcrições parciais.</strong> Os recortes abaixo não representam cobertura completa
        dos anos ou livros. Uma ausência nesta lista não prova ausência no documento.
      </aside>
    </section>
    <ListingsByPlace slices={slices} withTitle={false} />
  </div>
</Base>
