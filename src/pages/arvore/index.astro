---
import Base from '../../layouts/Base.astro';
import ArvoreGeracoes, { type NoArvore, type Uniao } from '../../components/arvore/ArvoreGeracoes';
import { carregarAcervo } from '../../lib/pessoas-build';
import { RAIZ_DA_LINHA, ROTULO_LINHA, anoCurto, dataAcervoLegivel, periodoVida, rotuloOcupacao } from '../../lib/pessoas';

const { pessoas, documentos, documentoPorId } = await carregarAcervo();
const nos: NoArvore[] = pessoas.map((p) => ({
  id: p.id,
  nome: p.nome_exibicao,
  outros: p.nomes_alternativos,
  vida: periodoVida(p),
  anoNasc: anoCurto(p.nascimento?.data).replace(/\D/g, '').slice(0, 4),
  anoMorte: anoCurto(p.morte?.data).replace(/\D/g, '').slice(0, 4),
  lugar: p.nascimento?.lugar ?? '',
  ocupacao: rotuloOcupacao(p.ocupacao),
  linha: p.linha,
  sexo: p.sexo,
  documentos: p.aparece_em.length,
  relacoes: p.relacoes.map((r) => ({ tipo: r.tipo, pessoa: r.pessoa, firmeza: r.firmeza, documentos: r.documentos })),
}));
const existe = (id?: string) => !!id && nos.some((n) => n.id === id);
const linhas = [
  { id: 'suraci', rotulo: 'Suraci → Sorage (Calábria)', raiz: RAIZ_DA_LINHA.suraci!, inclui: ['suraci', 'vecchia'] },
  { id: 'cardillo', rotulo: 'Cardillo → Cardilo (Campânia)', raiz: RAIZ_DA_LINHA.cardillo!, inclui: ['cardillo', 'marsicano'] },
].filter((l) => existe(l.raiz));

// O casal imigrante de cada linha: o cônjuge da raiz e o ato que registra o casamento.
const unioes: Uniao[] = linhas.flatMap((l) => {
  const raiz = pessoas.find((p) => p.id === l.raiz)!;
  return raiz.relacoes
    .filter((r) => r.tipo === 'conjuge')
    .map((r) => {
      const docs = r.documentos.map((id) => documentoPorId.get(id)).filter((d): d is NonNullable<typeof d> => !!d);
      const doc = docs.find((d) => d.tipo === 'casamento' || d.tipo === 'matrimonio') ?? docs[0];
      return {
        raiz: l.raiz,
        conjuge: r.pessoa,
        firmeza: r.firmeza,
        ...(doc ? { documento: { id: doc.id, titulo: doc.titulo, data: dataAcervoLegivel(doc.data_documento), lugar: doc.lugar } } : {}),
      };
    });
});
---

<Base
  titulo="Árvores de linhagem"
  descricao="As linhas Suraci → Sorage e Cardillo → Cardilo geração a geração, a partir dos dois imigrantes, com o caminho documentado até cada antepassado e a firmeza de cada ligação."
>
  <div class="space-y-8 py-8">
    <section class="border-b border-[#E7E2D8] pb-6 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <div class="text-xs uppercase tracking-widest font-sans font-semibold text-[#8C3A27] mb-1">Ascendência documentada · geração a geração</div>
        <h1 class="font-display text-3xl sm:text-4xl font-medium text-[#1C1917]">Árvores de linhagem: Suraci &amp; Cardillo</h1>
        <p class="font-editorial text-sm sm:text-base text-[#57534E] mt-1 max-w-2xl">
          Dos dois imigrantes para cima: pais, avós, bisavós, até onde os livros de Laganadi, Padula e Vibonati chegam.
          Cada ligação existe porque um ato a afirma, e aparece com a firmeza que esse ato permite. Escolha uma pessoa
          para ver o caminho documentado entre ela e o imigrante.
          <a href="/pessoas/" class="text-[#8C3A27] underline decoration-[#E8D9CE] hover:decoration-[#8C3A27]">Lista de todas as pessoas →</a>
        </p>
      </div>
    </section>

    <ArvoreGeracoes client:load pessoas={nos} linhas={linhas} unioes={unioes} totalDocumentos={documentos.length} rotulosLinha={ROTULO_LINHA} />
  </div>
</Base>
