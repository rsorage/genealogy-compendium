---
import Base from '../../layouts/Base.astro';
import TreeWindow, { type FiliationSource, type Mode, type TreeNode } from '../../components/tree/TreeWindow';
import { loadArchive } from '../../lib/persons-build';
import { LINE_ROOT, documentTypeLabel, readableArchiveDate, lifeSpan, occupationLabel } from '../../lib/persons';
import { placeContext, placeName, placeOf } from '../../lib/places';

const { persons, documentById } = await loadArchive();

/** Short name of a document's jurisdiction for the card lines; empty when there is no short name. */
const RECORD_KIND: Record<string, string> = { 'Registro civil': 'Registro civil', 'Arquivo paroquial': 'Registro paroquial', Catasto: 'Catasto', 'Leva militar': 'Leva militar' };
const KIND_RANK = (k: string) => (k === 'Registro civil' ? 0 : k === 'Registro paroquial' ? 1 : 2);

/**
 * The sources of a relation: the published acts (place, date), civil first, then parish — for a spouse the
 * marriage act first, for a parent the birth/baptism act first — or the reference to the unpublished one.
 */
function relationSources(type: string, documents: string[], reference?: string): FiliationSource[] {
  const docs = documents.map((id) => documentById.get(id)).filter((d): d is NonNullable<typeof d> => !!d);
  const preferred = type === 'spouse' ? ['marriage', 'parish_marriage'] : type === 'father' || type === 'mother' ? ['birth', 'baptism'] : [];
  const sorted = [...docs].sort(
    (a, b) => Number(!preferred.includes(a.type)) - Number(!preferred.includes(b.type)) || KIND_RANK(RECORD_KIND[a.jurisdiction] ?? '') - KIND_RANK(RECORD_KIND[b.jurisdiction] ?? ''),
  );
  if (sorted.length)
    return sorted.map((d) => ({ kind: RECORD_KIND[d.jurisdiction] ?? '', label: `${documentTypeLabel(d).toLowerCase()}, ${d.place}, ${readableArchiveDate(d.date)}`, document: d.id }));
  return [{ kind: '', label: reference ?? 'sem fonte' }];
}

const nodes: TreeNode[] = persons.map((p) => {
  const arrival = p.appearances.map((a) => documentById.get(a.document)!).find((d) => d.type === 'passenger_list');
  const place = placeOf(p.birth?.place);
  return {
    id: p.id,
    name: p.display_name,
    aliases: p.aliases,
    life: lifeSpan(p),
    ...(place ? { place: { name: placeName(place), context: placeContext(place) } } : {}),
    occupation: occupationLabel(p.occupation),
    emigration: arrival ? `Entrada no Brasil: ${arrival.year} (${documentTypeLabel(arrival).toLowerCase()})` : '',
    line: p.line,
    sex: p.sex,
    ...(p.anchor ? { anchor: p.anchor.label } : {}),
    noDossier: !!p.no_dossier,
    needsResearch: !!p.needs_research,
    relations: p.relations.map((r) => {
      const sources = relationSources(r.type, r.documents, r.reference);
      return { type: r.type, person: r.person, confidence: r.confidence, sourceLabel: sources[0].label, ...(sources[0].document ? { document: sources[0].document } : {}), sources };
    }),
  };
});
const exists = (id?: string) => !!id && nodes.some((n) => n.id === id);
const grandparents = ['P-sorage-wolney-1918', 'P-cardillo-marialuzia-1922'];
const modes: Mode[] = [
  ...(grandparents.every(exists) ? [{ id: 'grandparents', label: 'Meus avós', root: grandparents, lines: [] }] : []),
  ...(exists(LINE_ROOT.suraci) ? [{ id: 'suraci', label: 'Suraci → Sorage', root: [LINE_ROOT.suraci!], lines: ['suraci', 'vecchia'] }] : []),
  ...(exists(LINE_ROOT.cardillo) ? [{ id: 'cardillo', label: 'Cardillo → Cardilo', root: [LINE_ROOT.cardillo!], lines: ['cardillo', 'marsicano'] }] : []),
];
---

<Base
  title="Árvore"
  description="A ascendência das famílias Sorage (Suraci) e Cardillo a partir dos meus avós: pais, avós e bisavós, uma janela de cada vez, com o documento e a firmeza de cada ligação."
>
  <div class="space-y-8 py-8">
    <section class="border-b border-[#E7E2D8] pb-6">
      <div class="text-xs uppercase tracking-widest font-sans font-semibold text-[#8C3A27] mb-1">Ascendência · dos meus avós para cima</div>
      <h1 class="font-display text-3xl sm:text-4xl font-medium text-[#1C1917]">Árvore</h1>
      <p class="font-editorial text-sm sm:text-base text-[#57534E] mt-1 max-w-2xl">
        Começa onde as duas linhas se juntam, nos meus avós, e sobe: os pais deles são os quatro imigrantes e as
        mulheres deles. «Subir» em qualquer pessoa põe-na no pé da árvore e mostra os pais e os avós dela — sempre uma
        janela de poucas pessoas, cada ligação com o ato que a afirma.
        <a href="/pessoas/" class="text-[#8C3A27] underline decoration-[#E8D9CE] hover:decoration-[#8C3A27]">Todas as pessoas →</a>
      </p>
    </section>

    <TreeWindow client:load persons={nodes} modes={modes} />
  </div>
</Base>
