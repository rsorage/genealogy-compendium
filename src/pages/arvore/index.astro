---
import Base from '../../layouts/Base.astro';
import ArvoreJanela, { type Modo, type NoJanela } from '../../components/arvore/ArvoreJanela';
import { carregarAcervo } from '../../lib/pessoas-build';
import { RAIZ_DA_LINHA, ROTULO_TIPO_DOC, dataAcervoLegivel, periodoVida, rotuloOcupacao } from '../../lib/pessoas';
import { contextoDoLugar, lugarDe } from '../../lib/lugares';

const { pessoas, documentoPorId } = await carregarAcervo();

/**
 * Rótulo curto da fonte de uma ligação: o ato publicado (lugar, data) ou a referência ao não publicado.
 * Para cônjuge prefere o ato de casamento; para pai/mãe, o de nascimento ou batismo; senão o primeiro listado.
 */
function rotuloFonte(tipo: string, docs: string[], referencia?: string): { rotulo: string; documento?: string } {
  const ds = docs.map((id) => documentoPorId.get(id)).filter((d): d is NonNullable<typeof d> => !!d);
  const preferidos = tipo === 'conjuge' ? ['casamento', 'matrimonio'] : tipo === 'pai' || tipo === 'mae' ? ['nascita', 'battesimo', 'nascimento'] : [];
  const d = ds.find((x) => preferidos.includes(x.tipo)) ?? ds[0];
  if (d) return { rotulo: `${ROTULO_TIPO_DOC[d.tipo].toLowerCase()}, ${d.lugar}, ${dataAcervoLegivel(d.data_documento)}`, documento: d.id };
  return { rotulo: referencia ?? 'sem fonte' };
}

const nos: NoJanela[] = pessoas.map((p) => {
  const entrada = p.aparece_em.map((a) => documentoPorId.get(a.documento)!).find((d) => d.tipo === 'hospedaria' || d.tipo === 'lista_de_bordo');
  const lugar = lugarDe(p.nascimento?.lugar);
  return {
    id: p.id,
    nome: p.nome_exibicao,
    outros: p.nomes_alternativos,
    vida: periodoVida(p),
    ...(lugar ? { lugar: { nome: lugar.nome, contexto: contextoDoLugar(lugar), incerto: lugar.incerto } } : {}),
    ocupacao: rotuloOcupacao(p.ocupacao),
    emigracao: entrada ? `Entrada no Brasil: ${entrada.ano} (${ROTULO_TIPO_DOC[entrada.tipo].toLowerCase()})` : '',
    linha: p.linha,
    sexo: p.sexo,
    ...(p.ancora ? { ancora: p.ancora.rotulo } : {}),
    semDossie: !!p.sem_dossie,
    carecePesquisa: !!p.carece_pesquisa,
    relacoes: p.relacoes.map((r) => {
      const f = rotuloFonte(r.tipo, r.documentos, r.referencia);
      return { tipo: r.tipo, pessoa: r.pessoa, firmeza: r.firmeza, rotuloFonte: f.rotulo, ...(f.documento ? { documento: f.documento } : {}) };
    }),
  };
});
const existe = (id?: string) => !!id && nos.some((n) => n.id === id);
const avos = ['P-sorage-wolney-1918', 'P-cardillo-marialuzia-1922'];
const modos: Modo[] = [
  ...(avos.every(existe) ? [{ id: 'avos', rotulo: 'Meus avós', raiz: avos, linhas: [] }] : []),
  ...(existe(RAIZ_DA_LINHA.suraci) ? [{ id: 'suraci', rotulo: 'Suraci → Sorage', raiz: [RAIZ_DA_LINHA.suraci!], linhas: ['suraci', 'vecchia'] }] : []),
  ...(existe(RAIZ_DA_LINHA.cardillo) ? [{ id: 'cardillo', rotulo: 'Cardillo → Cardilo', raiz: [RAIZ_DA_LINHA.cardillo!], linhas: ['cardillo', 'marsicano'] }] : []),
];
---

<Base
  titulo="Árvore"
  descricao="A ascendência das famílias Sorage (Suraci) e Cardillo a partir dos meus avós: pais, avós e bisavós, uma janela de cada vez, com o documento e a firmeza de cada ligação."
>
  <div class="space-y-8 py-8">
    <section class="border-b border-[#E7E2D8] pb-6">
      <div class="text-xs uppercase tracking-widest font-sans font-semibold text-[#8C3A27] mb-1">Ascendência · dos meus avós para cima</div>
      <h1 class="font-display text-3xl sm:text-4xl font-medium text-[#1C1917]">Árvore</h1>
      <p class="font-editorial text-sm sm:text-base text-[#57534E] mt-1 max-w-2xl">
        Começa onde as duas linhas se juntam, nos meus avós, e sobe: os pais deles são os quatro imigrantes e as
        mulheres deles. «Subir» em qualquer pessoa põe-na no pé da árvore e mostra os pais e os avós dela — sempre uma
        janela de poucas pessoas, cada ligação com o ato que a afirma.
        <a href="/pessoas/" class="text-[#8C3A27] underline decoration-[#E8D9CE] hover:decoration-[#8C3A27]">Todas as pessoas →</a>
      </p>
    </section>

    <ArvoreJanela client:load pessoas={nos} modos={modos} />
  </div>
</Base>
